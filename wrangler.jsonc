    "CORE_KEY": "sb_publishable_PRSYVU-uzARBu1VejEvtjw_7jG7nnVT",
    "LINKS": { "dina": { "name": "مدارس دينا العالمية", "url": "https://dwibkkrzykqgsgyrrggp.supabase.co", "site": "https://ahmedabdelazem1460-ux.github.io/dina-tools/" } }
  },
  "keep_vars": true
}
